{
  "manifest_version": 3,
  "name": "SnipTeX",
  "version": "0.2.0",
  "description": "Copy any part of a Claude, ChatGPT, or Gemini reply as Markdown, with math kept as LaTeX.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sniptex@bhavesh",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "clipboardWrite",
    "menus",
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "vendor/turndown.js",
        "vendor/turndown-plugin-gfm.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "copy-as-markdown": {
      "suggested_key": {
        "default": "Ctrl+Alt+C"
      },
      "description": "Copy selection as Markdown (default math format)"
    },
    "copy-as-markdown-alt": {
      "description": "Copy selection as Markdown (other math format)"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
